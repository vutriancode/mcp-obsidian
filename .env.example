OBSIDIAN_API_KEY=your_api_key_here
OBSIDIAN_PROTOCOL=http
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27123

# Optional: use this to override protocol/host/port with a full base URL.
# OBSIDIAN_URL=http://127.0.0.1:27123

# Optional: only relevant when using https with a trusted certificate.
OBSIDIAN_VERIFY_SSL=false

MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
